<UserControl x:Class="VisualStudioPokemon.UI.PokemonControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="460"
             d:DesignWidth="780">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Pokemon.WindowBackgroundBrush" Color="#252526" />
        <SolidColorBrush x:Key="Pokemon.CommandBarBackgroundBrush" Color="#2D2D30" />
        <SolidColorBrush x:Key="Pokemon.PanelBackgroundBrush" Color="#252526" />
        <SolidColorBrush x:Key="Pokemon.EditorBackgroundBrush" Color="#1E1E1E" />
        <SolidColorBrush x:Key="Pokemon.BorderBrush" Color="#3F3F46" />
        <SolidColorBrush x:Key="Pokemon.TextBrush" Color="#F1F1F1" />
        <SolidColorBrush x:Key="Pokemon.MutedTextBrush" Color="#C8C8C8" />
        <SolidColorBrush x:Key="Pokemon.ControlBackgroundBrush" Color="#333337" />
        <SolidColorBrush x:Key="Pokemon.ControlBorderBrush" Color="#55555A" />
        <SolidColorBrush x:Key="Pokemon.ButtonBackgroundBrush" Color="#3A3D41" />
        <SolidColorBrush x:Key="Pokemon.AccentBrush" Color="#007ACC" />
        <SolidColorBrush x:Key="Pokemon.ComboBoxEditableBackgroundBrush" Color="#333337" />
        <SolidColorBrush x:Key="Pokemon.ComboBoxEditableTextBrush" Color="#F1F1F1" />

        <Style x:Key="Pokemon.LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Pokemon.TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Pokemon.CaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource Pokemon.LabelStyle}">
            <Setter Property="Foreground" Value="{DynamicResource Pokemon.MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- TextBox normale: NON modificata -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Pokemon.ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource Pokemon.TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Pokemon.TextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Pokemon.AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Pokemon.ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}" />
                                <TextBlock x:Name="WatermarkText"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="{DynamicResource Pokemon.MutedTextBrush}"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Opacity="0.85"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="WatermarkText" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="WatermarkText" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{DynamicResource Pokemon.AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stile usato SOLO dal TextBox interno delle ComboBox editabili -->
        <Style x:Key="Pokemon.ComboBoxEditableTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background"
            Value="{DynamicResource Pokemon.ControlBackgroundBrush}" />
            <Setter Property="Foreground"
            Value="{DynamicResource Pokemon.TextBrush}" />
            <Setter Property="CaretBrush"
            Value="{DynamicResource Pokemon.TextBrush}" />
            <Setter Property="SelectionBrush"
            Value="{DynamicResource Pokemon.AccentBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="Pokemon.ComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource Pokemon.ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource Pokemon.TextBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Pokemon.TextBrush}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Pokemon.AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource Pokemon.AccentContrastBrush}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Pokemon.AccentContrastBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Pokemon.AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource Pokemon.AccentContrastBrush}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Pokemon.AccentContrastBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Pokemon.MutedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToggleButton used inside the ComboBox template drop-down arrow -->
        <Style x:Key="Pokemon.ComboBoxToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{DynamicResource Pokemon.ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource Pokemon.ControlBorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <!-- Transparent left side that passes clicks through to the ContentSite -->
                                <Border Grid.Column="0" Background="Transparent" />
                                <!-- Arrow area -->
                                <Border Grid.Column="1"
                                        x:Name="ArrowBorder"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource Pokemon.ControlBorderBrush}"
                                        BorderThickness="1,0,0,0">
                                    <Path x:Name="Arrow"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="{DynamicResource Pokemon.TextBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Pokemon.AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Full ControlTemplate for non-editable ComboBox - gives us 100% control of selection text color -->
        <ControlTemplate x:Key="Pokemon.NonEditableComboBoxTemplate" TargetType="{x:Type ComboBox}">
            <Grid>
                <ToggleButton x:Name="ToggleButton"
                              Style="{StaticResource Pokemon.ComboBoxToggleButtonStyle}"
                              Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              ClickMode="Press" />
                <!-- Selection box: shows the selected value with explicit foreground -->
                <ContentPresenter x:Name="ContentSite"
                                  IsHitTestVisible="False"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  Margin="6,3,26,3"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  TextElement.Foreground="{DynamicResource Pokemon.TextBrush}" />
                <Popup x:Name="PART_Popup"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Slide">
                    <Grid x:Name="DropDown"
                          SnapsToDevicePixels="True"
                          MinWidth="{TemplateBinding ActualWidth}"
                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <Border x:Name="DropDownBorder"
                                Background="{DynamicResource Pokemon.ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource Pokemon.ControlBorderBrush}"
                                BorderThickness="1">
                            <ScrollViewer SnapsToDevicePixels="True">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.65" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Pokemon.ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource Pokemon.TextBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Pokemon.TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Pokemon.ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource Pokemon.ComboBoxItemStyle}" />
            <Setter Property="Template" Value="{StaticResource Pokemon.NonEditableComboBoxTemplate}" />
        </Style>

        <!-- ToggleButton used inside the EDITABLE ComboBox template (arrow-only, no outer border — the TextBox provides it) -->
        <Style x:Key="Pokemon.EditableComboBoxToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root" Background="Transparent" BorderThickness="0">
                            <Border x:Name="ArrowBorder"
                                    Width="20"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource Pokemon.ControlBorderBrush}"
                                    BorderThickness="1,0,0,0"
                                    HorizontalAlignment="Right">
                                <Path x:Name="Arrow"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                      Fill="{DynamicResource Pokemon.TextBrush}" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Full ControlTemplate for editable ComboBox (SpeciesCombo) -->
        <ControlTemplate x:Key="Pokemon.EditableComboBoxTemplate" TargetType="{x:Type ComboBox}">
            <Border x:Name="OuterBorder"
                    Background="{DynamicResource Pokemon.ComboBoxEditableBackgroundBrush}"
                    BorderBrush="{DynamicResource Pokemon.ControlBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <!-- The editable TextBox — WPF requires the name PART_EditableTextBox -->
                    <TextBox x:Name="PART_EditableTextBox"
                             Style="{StaticResource Pokemon.ComboBoxEditableTextBoxStyle}"
                             Margin="0,0,20,0"
                             IsReadOnly="{TemplateBinding IsReadOnly}" />
                    <!-- Arrow toggle button overlaid on the right -->
                    <ToggleButton Style="{StaticResource Pokemon.EditableComboBoxToggleButtonStyle}"
                                  Focusable="False"
                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  ClickMode="Press" />
                    <!-- Drop-down popup — WPF requires the name PART_Popup -->
                    <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Slide">
                        <Grid SnapsToDevicePixels="True"
                              MinWidth="{TemplateBinding ActualWidth}"
                              MaxHeight="{TemplateBinding MaxDropDownHeight}">
                            <Border Background="{DynamicResource Pokemon.ControlBackgroundBrush}"
                                    BorderBrush="{DynamicResource Pokemon.ControlBorderBrush}"
                                    BorderThickness="1">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource Pokemon.AccentBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.65" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Style applied ONLY to editable ComboBoxes (SpeciesCombo) -->
        <Style x:Key="Pokemon.EditableComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Pokemon.ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource Pokemon.TextBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Pokemon.TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Pokemon.ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="IsEditable" Value="True" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource Pokemon.ComboBoxItemStyle}" />
            <Setter Property="Template" Value="{StaticResource Pokemon.EditableComboBoxTemplate}" />
        </Style>

        <Style x:Key="Pokemon.ListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Pokemon.TextBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Pokemon.TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="2" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Pokemon.CommandBarBackgroundBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Pokemon.AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource Pokemon.AccentContrastBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Pokemon.AccentContrastBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Pokemon.ButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource Pokemon.TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Pokemon.ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Pokemon.TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource Pokemon.ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource Pokemon.TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Pokemon.ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource Pokemon.ListBoxItemStyle}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Pokemon.WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="8,6"
                Background="{DynamicResource Pokemon.CommandBarBackgroundBrush}"
                BorderBrush="{DynamicResource Pokemon.BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Roll-call" Click="RollCallButton_Click" />
                    <Button Content="Remove all" Click="RemoveAllButton_Click" Margin="0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="VS Pokemon"
                               Style="{StaticResource Pokemon.LabelStyle}"
                               FontWeight="SemiBold"
                               Margin="0,0,10,0" />
                    <TextBlock x:Name="StatusText"
                               Style="{StaticResource Pokemon.CaptionStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource Pokemon.PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource Pokemon.BorderBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <StackPanel Margin="10">
                        <TextBlock Text="Spawn"
                                   Style="{StaticResource Pokemon.LabelStyle}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <TextBlock Text="Species" Style="{StaticResource Pokemon.CaptionStyle}" Margin="0,0,0,3" />
                        <ComboBox x:Name="SpeciesCombo"
                                  Style="{StaticResource Pokemon.EditableComboBoxStyle}"
                                  DisplayMemberPath="DisplayName"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  StaysOpenOnEdit="True"
                                  MaxDropDownHeight="220"
                                  Margin="0,0,0,8"
                                  PreviewKeyDown="SpeciesCombo_PreviewKeyDown" />

                        <TextBlock Text="Nickname" Style="{StaticResource Pokemon.CaptionStyle}" Margin="0,0,0,3" />
                        <TextBox x:Name="NameBox"
                                 Margin="0,0,0,8"
                                 Tag="Optional nickname"
                                 ToolTip="Nickname. Leave blank for the species name." />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Size" Style="{StaticResource Pokemon.CaptionStyle}" Margin="0,0,0,3" />
                                <ComboBox x:Name="SizeCombo" IsEditable="False" />
                            </StackPanel>
                            <CheckBox x:Name="ShinyCheck" Grid.Column="1" Content="Shiny" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                        </Grid>

                        <UniformGrid Columns="2" Margin="0,0,0,14">
                            <Button Content="Spawn" Click="SpawnButton_Click" />
                            <Button Content="Random" Click="RandomButton_Click" Margin="0" />
                        </UniformGrid>

                        <Border Height="1" Margin="0,0,0,14" Background="{DynamicResource Pokemon.BorderBrush}" />

                        <TextBlock Text="Selected"
                                   Style="{StaticResource Pokemon.LabelStyle}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <ComboBox x:Name="SpawnedCombo"
                                  IsEditable="False"
                                  DisplayMemberPath="DisplayLabel"
                                  MaxDropDownHeight="180"
                                  Margin="0,0,0,8"
                                  SelectionChanged="SpawnedCombo_SelectionChanged" />
                        <TextBlock x:Name="SelectedDetailsText"
                                   Text="Click a Pokemon or select it here."
                                   Style="{StaticResource Pokemon.CaptionStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <Button x:Name="RemoveSelectedButton"
                                Content="Remove selected"
                                Click="RemoveSelectedButton_Click"
                                IsEnabled="False"
                                Margin="0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1"
                    Margin="8"
                    Background="{DynamicResource Pokemon.EditorBackgroundBrush}"
                    BorderBrush="{DynamicResource Pokemon.BorderBrush}"
                    BorderThickness="1"
                    MouseLeftButtonDown="Border_MouseLeftButtonDown">
                <Grid ClipToBounds="True">
                    <Canvas x:Name="Playground"
                            ClipToBounds="True"
                            SizeChanged="Playground_SizeChanged" />
                    <Canvas x:Name="PokeballLayer"
                            IsHitTestVisible="False"
                            ClipToBounds="True" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
